EXPO_PUBLIC_MINIMUM_CHATWOOT_VERSION=4.1.0
EXPO_PUBLIC_PROJECT_ID=
EXPO_PUBLIC_APP_SLUG=

# Файлы Firebase (проект «ConOmni», Android-приложение ru.conomni.app).
# Лежат в firebase/ — каталог в .gitignore, файлы НЕ коммитить.
# google-services.json скачивается из console.firebase.google.com;
# GoogleService-Info.plist — когда появится iOS-приложение.
# Сервис-аккаунт для сервера (FIREBASE_CREDENTIALS на sel1) — только Bitwarden «ConOmni Firebase».
EXPO_PUBLIC_IOS_GOOGLE_SERVICES_FILE=./firebase/GoogleService-Info.plist
EXPO_PUBLIC_ANDROID_GOOGLE_SERVICES_FILE=./firebase/google-services.json

EXPO_APPLE_ID=
EXPO_APPLE_TEAM_ID=
EXPO_STORYBOOK_ENABLED=false

# Релизная подпись Android: keystore в release/ (тоже .gitignore),
# пароли — Bitwarden «ConOmni Android keystore».
# Значения читает android/app/build.gradle через ~/.gradle/gradle.properties:
#   CONOMNI_UPLOAD_STORE_FILE, CONOMNI_UPLOAD_KEY_ALIAS,
#   CONOMNI_UPLOAD_STORE_PASSWORD, CONOMNI_UPLOAD_KEY_PASSWORD
